import '../../schema.drift';

selectById: SELECT * from board_tb WHERE board_tb.id = ?;

selectByName: SELECT * from board_tb WHERE board_tb.name = ?;

searchBoard(:query AS TEXT):
	SELECT * FROM board_tb
	WHERE
		name LIKE '%' || :query || '%' AND
		is_deleted = false;

toggleIsDeleted:
	UPDATE board_tb
	SET is_deleted = NOT is_deleted
	WHERE id = ?;

selectDeleted: SELECT * FROM board_tb WHERE is_deleted = TRUE;