import '../../schema.drift';

pinSymbolToBoard(:board_id AS INTEGER, :symbol_id AS INTEGER):
	WITH helpers as (
		SELECT (COALESCE((SELECT MAX(position) FROM child_symbol_tb WHERE board_id = :board_id), -1) + 1) as position
	)
	INSERT OR REPLACE INTO child_symbol_tb (board_id, symbol_id, position)
		VALUES (:board_id, :symbol_id, (SELECT position FROM helpers));

searchSymbol(:query AS TEXT, :onlyPinned AS BOOLEAN, :color AS INTEGER OR NULL):
	SELECT DISTINCT s.* FROM communication_symbol_tb s
		LEFT JOIN child_symbol_tb cs ON cs.symbol_id = s.id
		WHERE s.label LIKE '%' || :query || '%' AND
			(NOT :onlyPinned OR cs.board_id IS NULL)	AND
			(:color IS NULL OR s.color = :color)		AND
			is_deleted = false;

markAsDeleted:
	UPDATE communication_symbol_tb
	SET is_deleted = true
	WHERE id = ?;

restoreSymbol:
	UPDATE communication_symbol_tb
	SET is_deleted = false
	WHERE id = ?;

deletePermanently:
	DELETE FROM communication_symbol_tb where id = ?; 

selectDeleted:
	SELECT * from communication_symbol_tb where is_deleted = true;

